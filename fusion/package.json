{
  "name": "fusion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A typed drop-in layer over React: agents write normal React, the wrong things fail to compile.",
  "exports": {
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./src/react.ts"
    },
    "./vite": "./vite.ts",
    "./tsconfig": "./tsconfig.preset.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/types/tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@types/react": "~19.3.0",
    "react": "~19.3.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
